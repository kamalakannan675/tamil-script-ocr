# TamilScript OCR Platform - Environment Configuration

# Flask Backend Settings
PORT=5000
FLASK_DEBUG=False
FLASK_ENV=production
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Machine Learning & Inference Settings
DEVICE=cpu
CRNN_MODEL_PATH=backend/models/tamil_crnn.pt

# Limits & Quotas
MAX_CONTENT_LENGTH=26214400 # 25 MB in bytes
MAX_IMAGE_DIMENSION=5000
MAX_PDF_PAGES=20
MAX_PROCESSING_TIMEOUT=120

# CORS Configuration
CORS_ORIGINS=*

# Frontend Environment Variables (Prefix with VITE_)
VITE_API_URL=/api
